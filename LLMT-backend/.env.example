APP_NAME=离线大数据训练与应用系统
APP_ENV=development
DEBUG=true
API_PREFIX=/api
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=llmt_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE_URL=

INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=change-this-influxdb-token
INFLUXDB_ORG=llmt
INFLUXDB_BUCKET=training_metrics

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_CHECKPOINTS=checkpoints
MINIO_SECURE=false

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_LOGS=system-logs
